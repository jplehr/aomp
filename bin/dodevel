#!/bin/bash
# shellcheck source-path=SCRIPTDIR
#
# dodevel: turn a task name into a complete AOMP development environment.
#
# Given a task name, dodevel selects (or creates) matching component worktrees,
# builds the shared development image if needed, and starts a persistent
# per-task container. With no argument it defaults to the "amd-staging" task.
# The -rm form removes only the named task's container, worktrees, and build
# outputs; it preserves branches and all other bind-mounted data.
#
#   dodevel                    # amd-staging task, uses the main worktrees
#   dodevel feat-to-impl       # create or enter the feat-to-impl environment
#   dodevel -rm feat-to-impl   # remove that environment, preserving branches
#
# Environment overrides:
#   ROCM_NIGHTLY_DATE=YYYYMMDD  pin an exact ROCm nightly (overrides the anchor)
#   DODEVEL_REBUILD=1           force an image rebuild (after editing the Docker
#                               recipe or prerequisites)
#   DODEVEL_UPDATE_CLAUDE=1     refresh the late Claude Code and GitHub CLI layers
#   DODEVEL_UPDATE_GH=1         refresh only the final GitHub CLI image layer

set -euo pipefail

# --- Locate the workspace ------------------------------------------------------
# This script lives at ${Workspace}/aomp/bin/dodevel, so the workspace root is
# three levels up. Deriving it from the script location means dodevel works
# regardless of the current directory.
RealPath="$(realpath "$0")"
ScriptDir="$(dirname "${RealPath}")"
Workspace="$(realpath "${ScriptDir}/../..")"

AnchorScript="${ScriptDir}/rocm-nightly-anchor.sh"
BuildbotsDir="${Workspace}/aomp/upstream-buildbots"
DockerfileDir="${BuildbotsDir}/manylinux-devel"

# Interdependent components managed symmetrically. For a given task each gets a
# parallel <repo>-<task> worktree on branch <task>, created/validated identically.
# Each entry is "<repo>:<base-branch>": the base branch a new <task> branch is cut
# from, and the branch the no-argument default expects the main checkout to be on.
# Most components track amd-staging; the AOMP repo itself tracks aomp-dev. Add a
# repo here to bring it under the same management. The container starts in the
# first component's worktree.
Components=(
  "llvm-project:amd-staging"
  "SPIRV-LLVM-Translator:amd-staging"
  "aomp:aomp-dev"
)

ImageTag="jp/aomp-devel"
BaseImageTag="localhost/manylinux:base"
# Task label used when no argument is given (container name, worktree suffix).
DefaultTask="amd-staging"

# --- Small helpers -------------------------------------------------------------
function die() {
  echo "dodevel: error: $*" >&2
  exit 1
}

function warn() {
  echo "dodevel: warning: $*" >&2
}

function info() {
  echo "dodevel: $*"
}

# --- Parse arguments -----------------------------------------------------------
RemoveMode=0
if [ "${1:-}" = "-rm" ]; then
  RemoveMode=1
  shift
  [ "$#" -eq 1 ] || die "usage: dodevel -rm <task>"
elif [ "$#" -gt 1 ]; then
  die "expected at most one task name, got $#: $*"
fi

Task="${1:-${DefaultTask}}"

# Conservative Docker/Git-compatible task name: lowercase alnum and dashes,
# starting with an alnum. Keeps container names and branch names safe.
if [[ ! "${Task}" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
  die "invalid task name '${Task}'; use lowercase letters, digits, and dashes (must start with a letter or digit)"
fi

if [ "${RemoveMode}" = "1" ] && { [ "${Task}" = "${DefaultTask}" ] || [ "${Task}" = "aomp-dev" ]; }; then
  die "refusing to remove protected task '${Task}'"
fi

ContainerName="jp-${Task}"

# Per-task build and install trees prefer local NVMe over the typically
# NFS-mounted home directory. This path is also the only output tree removed by
# -rm; it must stay identical to the path used when creating the environment.
TaskRoot="${HOME}/.cache/dodevel/${Task}"
[ -d "/work/${USER}" ] && TaskRoot="/work/${USER}/.cache/dodevel/${Task}"

# --- Preconditions -------------------------------------------------------------
command -v docker >/dev/null 2>&1 || die "docker is not available on PATH"
docker info >/dev/null 2>&1 || die "cannot talk to the Docker daemon; is it running and are you in the docker group?"

for Entry in "${Components[@]}"; do
  Component="${Entry%%:*}"
  Main="${Workspace}/${Component}"
  [ -d "${Main}/.git" ] || [ -f "${Main}/.git" ] ||
    die "expected a ${Component} checkout at ${Main}, but it is not a git repository"
  git -C "${Main}" rev-parse --git-dir >/dev/null 2>&1 ||
    die "${Main} is not a valid git worktree"
done

# --- Resolve the worktree for each component ----------------------------------
# Every component is created/validated identically for the task. Worktree is set
# to the first component's worktree, where the container starts.
Worktree=""

function currentBranch() {
  git -C "$1" rev-parse --abbrev-ref HEAD 2>/dev/null
}

function isRegisteredWorktree() {
  # True if worktree $2 is registered as a worktree of main repo $1.
  local main="$1" target
  target="$(realpath "$2")"
  git -C "${main}" worktree list --porcelain 2>/dev/null |
    awk '/^worktree /{print $2}' |
    while IFS= read -r wt; do
      [ "$(realpath "${wt}")" = "${target}" ] && echo yes && break
    done | grep -q yes
}

function preflightRemoval() {
  local entry component main worktree status gitDir
  local failed=0

  for entry in "${Components[@]}"; do
    component="${entry%%:*}"
    main="${Workspace}/${component}"
    worktree="${Workspace}/${component}-${Task}"

    # Check -L first so a broken link is recognized, and never resolve a
    # top-level link that cleanup is meant to unlink rather than traverse.
    if [ -L "${worktree}" ]; then
      continue
    elif [ ! -e "${worktree}" ]; then
      # A manually deleted worktree can remain registered. Git can safely clean
      # that administrative entry during removal, so absence alone is fine.
      continue
    elif [ ! -d "${worktree}" ]; then
      warn "refusing to remove unexpected non-directory ${worktree}"
      failed=1
      continue
    elif ! isRegisteredWorktree "${main}" "${worktree}"; then
      warn "refusing to remove ${worktree}; it is not a linked worktree of ${main}"
      failed=1
      continue
    fi

    if ! gitDir="$(git -C "${worktree}" rev-parse --absolute-git-dir 2>/dev/null)"; then
      warn "refusing to remove ${worktree}; Git cannot inspect it"
      failed=1
      continue
    fi
    if [ -e "${gitDir}/locked" ]; then
      warn "refusing to remove locked worktree ${worktree}"
      failed=1
      continue
    fi
    if ! status="$(git -C "${worktree}" status --porcelain --untracked-files=all)"; then
      warn "refusing to remove ${worktree}; Git cannot determine whether it is clean"
      failed=1
    elif [ -n "${status}" ]; then
      warn "refusing to remove dirty worktree ${worktree}; commit, stash, or clean it first"
      failed=1
    fi
  done

  if [ ! -L "${TaskRoot}" ] && [ -e "${TaskRoot}" ] && [ ! -d "${TaskRoot}" ]; then
    warn "refusing to remove unexpected non-directory ${TaskRoot}"
    failed=1
  fi

  [ "${failed}" = "0" ]
}

function removeWorktree() {
  local main="$1"
  local worktree="$2"
  local status gitDir

  if [ -L "${worktree}" ]; then
    info "removing worktree symlink ${worktree} without following it"
    rm -- "${worktree}"
  elif [ -e "${worktree}" ]; then
    [ -d "${worktree}" ] ||
      die "${worktree} changed after preflight; refusing to remove it"
    isRegisteredWorktree "${main}" "${worktree}" ||
      die "${worktree} changed after preflight; refusing to remove it"
    gitDir="$(git -C "${worktree}" rev-parse --absolute-git-dir 2>/dev/null)" ||
      die "Git can no longer inspect ${worktree}; refusing to remove it"
    [ ! -e "${gitDir}/locked" ] ||
      die "${worktree} became locked after preflight; refusing to remove it"
    status="$(git -C "${worktree}" status --porcelain --untracked-files=all)" ||
      die "Git can no longer determine whether ${worktree} is clean"
    [ -z "${status}" ] ||
      die "${worktree} became dirty after preflight; refusing to remove it"
    info "removing worktree ${worktree}"
    git -C "${main}" worktree remove "${worktree}"
  elif isRegisteredWorktree "${main}" "${worktree}"; then
    info "removing stale worktree registration for ${worktree}"
    git -C "${main}" worktree remove "${worktree}"
  else
    info "worktree ${worktree} is already absent"
  fi
}

function removeTaskRoot() {
  if [ -L "${TaskRoot}" ]; then
    info "removing task output symlink ${TaskRoot} without following it"
    rm -- "${TaskRoot}"
  elif [ -d "${TaskRoot}" ]; then
    info "removing task output directory ${TaskRoot}"
    rm -rf -- "${TaskRoot}"
  elif [ -e "${TaskRoot}" ]; then
    die "${TaskRoot} changed after preflight; refusing to remove it"
  else
    info "task output directory ${TaskRoot} is already absent"
  fi
}

function removeEnvironment() {
  preflightRemoval || die "removal preflight failed; nothing was removed"

  local state entry component main worktree
  state="$(docker inspect -f '{{.State.Status}}' "${ContainerName}" 2>/dev/null || true)"
  if [ -n "${state}" ]; then
    info "removing container ${ContainerName}"
    docker rm -f "${ContainerName}"
  else
    info "container ${ContainerName} is already absent"
  fi

  for entry in "${Components[@]}"; do
    component="${entry%%:*}"
    main="${Workspace}/${component}"
    worktree="${Workspace}/${component}-${Task}"

    removeWorktree "${main}" "${worktree}"
  done

  removeTaskRoot

  info "removed environment '${Task}'; branches and bind-mounted data were preserved"
}

if [ "${RemoveMode}" = "1" ]; then
  removeEnvironment
  exit 0
fi

function localBranchExists() {
  git -C "$1" show-ref --verify --quiet "refs/heads/$2"
}

function remoteBranchRef() {
  # Echo the first remote-tracking ref in main repo $1 matching branch $2.
  git -C "$1" for-each-ref --format='%(refname:short)' \
    "refs/remotes/*/$2" 2>/dev/null | head -1
}

# Resolve one component's worktree for the task, creating/validating as needed.
# Args: <repo> <base-branch>. The base branch is what a new <task> branch is cut
# from and what the no-argument default expects the main checkout to be on (this
# differs per repo: most track amd-staging, aomp tracks aomp-dev).
# Sets the global ResolvedWorktree (not stdout, so info/warn output stays clean).
function resolveComponent() {
  local component="$1"
  local baseBranch="$2"
  local main="${Workspace}/${component}"

  if [ "${Task}" = "${DefaultTask}" ]; then
    # Default task: use the main worktree as-is. We expect it on its base branch,
    # but today it often is not (that branch may live in a sibling worktree). Warn
    # rather than fail; this tightens into an assertion once things are cleaned.
    local branch
    branch="$(currentBranch "${main}")"
    if [ "${branch}" != "${baseBranch}" ]; then
      warn "expected ${main} to be on '${baseBranch}', but it is on '${branch}'; using it as-is"
    fi
    ResolvedWorktree="${main}"
    return 0
  fi

  local worktree="${Workspace}/${component}-${Task}"
  if [ -e "${worktree}" ]; then
    isRegisteredWorktree "${main}" "${worktree}" ||
      die "${worktree} exists but is not a linked worktree of ${main}"
    local branch
    branch="$(currentBranch "${worktree}")"
    [ "${branch}" = "${Task}" ] ||
      die "${worktree} is on branch '${branch}', expected '${Task}'"
    info "reusing existing worktree ${worktree} (branch ${Task})"
  elif localBranchExists "${main}" "${Task}"; then
    info "creating worktree ${worktree} from existing local branch ${Task}"
    git -C "${main}" worktree add "${worktree}" "${Task}"
  else
    local remoteRef
    remoteRef="$(remoteBranchRef "${main}" "${Task}")"
    if [ -n "${remoteRef}" ]; then
      info "creating worktree ${worktree} tracking ${remoteRef}"
      git -C "${main}" worktree add --track -b "${Task}" "${worktree}" "${remoteRef}"
    else
      localBranchExists "${main}" "${baseBranch}" ||
        die "cannot create branch '${Task}' in ${component}: no local '${baseBranch}' branch to base it on"
      info "creating worktree ${worktree} with new branch ${Task} from ${baseBranch}"
      git -C "${main}" worktree add -b "${Task}" "${worktree}" "${baseBranch}"
    fi
  fi
  ResolvedWorktree="${worktree}"
}

# Capture each component's resolved worktree so the container can point the AOMP
# build scripts at this task's sources (via the centralized AOMP_*_SRC vars).
declare -A ComponentWorktree
for Entry in "${Components[@]}"; do
  ThisComponent="${Entry%%:*}"
  resolveComponent "${ThisComponent}" "${Entry#*:}"
  ComponentWorktree["${ThisComponent}"]="${ResolvedWorktree}"
  [ -z "${Worktree}" ] && Worktree="${ResolvedWorktree}"
done

# --- Build the development image if needed ------------------------------------
function imageExists() {
  docker image inspect "$1" >/dev/null 2>&1
}

function buildBaseImage() {
  # The base recipe COPYs helper scripts that live only in TheRock, so it cannot
  # be built from a single vendored file. run.py downloads the Dockerfile plus
  # those scripts and builds only the shared base image.
  local RunPy="${BuildbotsDir}/run.py"
  [ -x "${RunPy}" ] || [ -f "${RunPy}" ] ||
    die "cannot build base image: helper ${RunPy} not found"
  # run.py downloads TheRock's base context into <dest>/manylinux-base. Keep that
  # scratch out of the tracked source tree by using a cache dir. Prefer the local
  # NVMe /work/${USER} over the typically NFS-mounted ${HOME}.
  local CacheRoot="${HOME}/.cache"
  if [ -d "/work/${USER}" ]; then
    CacheRoot="/work/${USER}/.cache"
  fi
  local BaseDest="${CacheRoot}/dodevel"
  mkdir -p "${BaseDest}"
  info "building base image ${BaseImageTag} via run.py (downloads TheRock recipe + scripts)"
  python3 "${RunPy}" manylinux-devel --pull --base-only --dest "${BaseDest}" ||
    die "base image build failed (see run.py output above)"
}

function buildImage() {
  if ! imageExists "${BaseImageTag}"; then
    buildBaseImage
  fi
  imageExists "${BaseImageTag}" || die "base image '${BaseImageTag}' still missing after build attempt"

  local RenderGid VideoGid MaxDate
  RenderGid="$(getent group render | cut -d: -f3)"
  VideoGid="$(getent group video | cut -d: -f3)"
  [ -n "${RenderGid}" ] || die "no 'render' group on host; cannot map GPU access"
  [ -n "${VideoGid}" ] || die "no 'video' group on host; cannot map GPU access"

  # Weekly Sunday anchor keeps the ROCm layer cached Mon..Sat while advancing
  # the nightly once a week. An exact pin overrides it.
  MaxDate="$("${AnchorScript}")" ||
    die "failed to compute ROCm nightly anchor (see ${AnchorScript}); is America/Chicago tzdata installed?"

  local -a BuildArgs=(
    --build-arg "BUILD_USER=$(id -un)"
    --build-arg "BUILD_UID=$(id -u)"
    --build-arg "BUILD_GID=$(id -g)"
    --build-arg "RENDER_GID=${RenderGid}"
    --build-arg "VIDEO_GID=${VideoGid}"
    --build-arg "ROCM_NIGHTLY_MAX_DATE=${MaxDate}"
  )
  if [ -n "${ROCM_NIGHTLY_DATE:-}" ]; then
    BuildArgs+=(--build-arg "ROCM_NIGHTLY_DATE=${ROCM_NIGHTLY_DATE}")
  fi
  if [ "${DODEVEL_UPDATE_CLAUDE:-0}" = "1" ]; then
    BuildArgs+=(--build-arg "CLAUDE_CODE_CACHE_BUST=$(date -u +%s%N)")
  fi
  if [ "${DODEVEL_UPDATE_GH:-0}" = "1" ]; then
    BuildArgs+=(--build-arg "GH_CLI_CACHE_BUST=$(date -u +%s%N)")
  fi

  info "building image ${ImageTag} (ROCm nightly max date ${MaxDate})"
  docker build "${BuildArgs[@]}" -t "${ImageTag}" "${DockerfileDir}"
}

if [ "${DODEVEL_REBUILD:-0}" = "1" ] || [ "${DODEVEL_UPDATE_CLAUDE:-0}" = "1" ] || [ "${DODEVEL_UPDATE_GH:-0}" = "1" ] || ! imageExists "${ImageTag}"; then
  buildImage
fi

# --- Enter or create the container --------------------------------------------
function containerState() {
  # Echo the container's State.Status, or empty if it does not exist.
  docker inspect -f '{{.State.Status}}' "${ContainerName}" 2>/dev/null || true
}

State="$(containerState)"

if [ "${State}" = "running" ]; then
  info "attaching to running container ${ContainerName}"
  exec docker exec -it "${ContainerName}" /bin/bash --login
elif [ -n "${State}" ]; then
  info "starting existing container ${ContainerName}"
  exec docker start -ai "${ContainerName}"
fi

# --- First run for this task: assemble mounts and create the container ---------
info "creating container ${ContainerName} in ${Worktree}"

Home="${HOME}"
RenderGid="$(getent group render | cut -d: -f3)"
VideoGid="$(getent group video | cut -d: -f3)"

declare -a RunArgs=(
  --name "${ContainerName}"
  --workdir "${Worktree}"
  --device /dev/kfd
  --device /dev/dri
  --group-add "${VideoGid}"
  --group-add "${RenderGid}"
  --cap-add SYS_PTRACE
  --security-opt seccomp=unconfined
  --ipc=host
)

# AOMP build environment: point the build scripts at THIS task's component
# worktrees, and give the task its own build and install trees so concurrent
# task containers never share or clobber each other's outputs. This relies on
# the centralized AOMP_*_SRC / BUILD_AOMP / AOMP overrides in aomp_common_vars;
# with them unset the scripts fall back to the historical shared layout.
#
# Sources: map each managed component's worktree to its build-script variable.
# Keyed by component name via a case, avoiding hyphenated literal array
# subscripts (which some shell formatters misparse as arithmetic).
for ThisComponent in "${!ComponentWorktree[@]}"; do
  wt="${ComponentWorktree[${ThisComponent}]}"
  case "${ThisComponent}" in
  llvm-project) RunArgs+=(-e "AOMP_PROJECT_SRC=${wt}") ;;
  SPIRV-LLVM-Translator) RunArgs+=(-e "AOMP_SPIRV_SRC=${wt}") ;;
  aomp) RunArgs+=(-e "AOMP_SRC=${wt}") ;;
  esac
done

# Per-task build and install trees on local NVMe (mirrors the base-image cache
# choice: prefer /work/${USER}, fall back to ${HOME}). BUILD_AOMP redirects the
# whole build tree; AOMP + AOMP_VERSION_MOD give a distinct, self-labeling
# install dir and compiler symlink per task.
mkdir -p "${TaskRoot}/build" "${TaskRoot}/install"
RunArgs+=(
  -v "${TaskRoot}:${TaskRoot}"
  -e "BUILD_AOMP=${TaskRoot}/build"
  -e "AOMP=${TaskRoot}/install/aomp"
  -e "AOMP_VERSION_MOD=${Task}"
)

# Source tree and related host trees, all at identical paths so absolute paths
# stored in git worktree metadata keep resolving inside the container.
RunArgs+=(-v "${Home}/git:${Home}/git")

# The workspace root lives outside ${HOME}/git (e.g. under /work), so mount it
# separately at its identical path.
case "${Workspace}/" in
"${Home}/git/"*) : ;; # already covered by the ${HOME}/git mount
*) RunArgs+=(-v "${Workspace}:${Workspace}") ;;
esac

# Tickets.
TicketsDir="/work1/${USER}/tickets"
if [ -d "${TicketsDir}" ]; then
  RunArgs+=(-v "${TicketsDir}:${TicketsDir}")
else
  warn "tickets directory ${TicketsDir} not found; not mounting it"
fi

# Shared NFS-backed compiler archive. Resolve the host symlink and expose the
# archive at its conventional /COD path; experiments consume but do not modify it.
if [ -e /COD ]; then
  CODTarget="$(realpath /COD)"
  RunArgs+=(-v "${CODTarget}:/COD:ro")
else
  warn "/COD not found; not mounting the compiler archive"
fi

# Git identity: mount the host ~/.gitconfig read-only so commits inside the
# container carry the correct user.name/user.email (and aliases). Read-only
# keeps it host-owned; the container never needs to edit it.
if [ -r "${Home}/.gitconfig" ]; then
  RunArgs+=(-v "${Home}/.gitconfig:${Home}/.gitconfig:ro")
else
  warn "${Home}/.gitconfig not found; git commits inside the container will lack an identity"
fi

# --- Credentials, provided only at runtime ------------------------------------
# Never bake secrets into the image; mount host-owned files instead.

# Claude state: ~/.claude is a symlink on the host whose target lies outside the
# mounted trees. Mount the resolved target read-write at its identical path, and
# hand the target to the container so the login shell can recreate the symlink.
if [ -e "${Home}/.claude" ]; then
  ClaudeTarget="$(realpath "${Home}/.claude")"
  RunArgs+=(-v "${ClaudeTarget}:${ClaudeTarget}")
  RunArgs+=(-e "DODEVEL_CLAUDE_TARGET=${ClaudeTarget}")
fi

# Claude onboarding/auth state lives in the ~/.claude.json FILE (separate from
# the ~/.claude dir): hasCompletedOnboarding, customApiKeyResponses, theme, and
# per-project trust. Mount it read-only so Claude stops re-onboarding on every
# start. Read-only means new folders trusted inside the container are not saved
# back, so a first visit to a new worktree still prompts for trust once.
if [ -r "${Home}/.claude.json" ]; then
  RunArgs+=(-v "${Home}/.claude.json:${Home}/.claude.json:ro")
else
  warn "${Home}/.claude.json not found; Claude will run its onboarding prompts"
fi

# Credential/env loader, read-only.
if [ -r "${Home}/.load-claude.sh" ]; then
  RunArgs+=(-v "${Home}/.load-claude.sh:${Home}/.load-claude.sh:ro")
else
  warn "${Home}/.load-claude.sh not found; container will start without it"
fi

# Token directory, read-only when present.
if [ -e "${Home}/.a-tokens" ]; then
  ATokensTarget="$(realpath "${Home}/.a-tokens")"
  RunArgs+=(-v "${ATokensTarget}:${ATokensTarget}:ro")
  [ "${ATokensTarget}" = "${Home}/.a-tokens" ] ||
    RunArgs+=(-v "${Home}/.a-tokens:${Home}/.a-tokens:ro")
fi

# SSH: forward the agent socket if available, otherwise mount ~/.ssh read-only.
if [ -n "${SSH_AUTH_SOCK:-}" ] && [ -S "${SSH_AUTH_SOCK}" ]; then
  RunArgs+=(-v "${SSH_AUTH_SOCK}:${SSH_AUTH_SOCK}")
  RunArgs+=(-e "SSH_AUTH_SOCK=${SSH_AUTH_SOCK}")
elif [ -d "${Home}/.ssh" ]; then
  RunArgs+=(-v "${Home}/.ssh:${Home}/.ssh:ro")
else
  warn "no SSH agent socket and no ${Home}/.ssh; container will start without SSH credentials"
fi

exec docker run -it "${RunArgs[@]}" "${ImageTag}" /bin/bash --login
